{
  "expo": {
    "name": "CargoVibe Parking",
    "slug": "cargovibe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cargovibe",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSMicrophoneUsageDescription": "The assistant uses the microphone to hear your questions.",
        "NSSpeechRecognitionUsageDescription": "The assistant converts your speech to text on this device."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "usesCleartextTraffic": true,
      "permissions": [
        "RECORD_AUDIO"
      ],
      "package": "com.genrativeai.cargovibe"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "The assistant uses the microphone to hear your questions.",
          "speechRecognitionPermission": "The assistant converts your speech to text on this device."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "52ec5d1b-3ed4-4f45-8361-55e4a044846e"
      }
    },
    "owner": "genrative-ai"
  }
}
